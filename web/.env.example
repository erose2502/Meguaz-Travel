# Copy to .env.local and fill in. Server-only keys must never get a NEXT_PUBLIC_ prefix.
DUFFEL_API_KEY=
SEARCHAPI_API_KEY=
PERPLEXITY_API_KEY=
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5-nano
OPENAI_FALLBACK_MODEL=gpt-5-mini

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

MAX_TOKENS_PER_SESSION=60000
MAX_HISTORY_TURNS=8

# Salt for hashing client IPs before they are stored. Use a unique random value
# per environment; rotating it resets anonymous rate-limit buckets.
IP_HASH_SALT=

# Set true only when Duffel Stays is enabled on your Duffel account.
DUFFEL_STAYS_ENABLED=false

# Mapbox token enables live traffic-aware ETAs (falls back to distance estimate if unset).
MAPBOX_TOKEN=

# Google Routes API for traffic-aware ETAs (optional; preferred over Mapbox when set).
GOOGLE_MAPS_API_KEY=

# ElevenLabs text-to-speech for destination phrase pronunciation.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# YouTube Data API v3 — destination soundtrack search (cached 7 days/city).
# Restrict the key to this API in Google Cloud Console.
YOUTUBE_API_KEY=

# ── Global daily spend caps ───────────────────────────────────────────────────
# Calls per provider per UTC day, across ALL users combined. Every paid
# provider call checks its cap first and FAILS CLOSED: if the Supabase ledger
# is configured but unreachable, paid calls are refused rather than unmetered.
# 0 blocks a provider entirely (kill switch). Defaults apply when unset.
SPEND_CAP_DUFFEL=400
SPEND_CAP_PERPLEXITY=150
SPEND_CAP_OPENAI=1500
SPEND_CAP_ELEVENLABS=400
SPEND_CAP_SEARCHAPI=150
SPEND_CAP_MAPS=2000
SPEND_CAP_WHATSAPP=300
SPEND_CAP_META=5000

# ── Meta developer platform ──────────────────────────────────────────────────
# All optional — every Meta feature no-ops until its credentials exist.
# WhatsApp Cloud API (Meta app → WhatsApp → API Setup): booking confirmations.
# hello_world is the pre-approved starter template; once your booking template
# (body slots: destination, reference, total) is approved, name it here.
META_WA_TOKEN=
META_WA_PHONE_ID=
META_WA_TEMPLATE=hello_world
# Meta Pixel + Conversions API (Events Manager → your dataset). The Pixel ID
# is public by design (served to browsers via /api/config); the CAPI token is
# server-only.
META_PIXEL_ID=
META_CAPI_TOKEN=
# Show the "Continue with Facebook" button. Flip to true only after the Meta
# app passes business verification AND the Facebook provider is enabled in
# Supabase — the button is hidden until then so it can't dead-end users.
FACEBOOK_LOGIN_ENABLED=false

# ── Error tracking ────────────────────────────────────────────────────────────
# Optional Sentry DSN. Server errors and client crash reports are forwarded
# there; without it they still land in stdout as structured JSON log lines.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# ── EC2 / self-hosting ────────────────────────────────────────────────────────
# Domain Caddy serves + provisions TLS for (see deploy/docker-compose.yml),
# e.g. www.meguaz.com — full steps in docs/ec2-deploy-web.md.
MEGUAZ_DOMAIN=
