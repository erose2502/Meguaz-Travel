# Copy to .env.local and fill in. Server-only keys must never get a NEXT_PUBLIC_ prefix.
DUFFEL_API_KEY=
SEARCHAPI_API_KEY=
PERPLEXITY_API_KEY=
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5-nano
OPENAI_FALLBACK_MODEL=gpt-5-mini

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

MAX_TOKENS_PER_SESSION=60000
MAX_HISTORY_TURNS=8

# Salt for hashing client IPs before they are stored. Use a unique random value
# per environment; rotating it resets anonymous rate-limit buckets.
IP_HASH_SALT=

# Set true only when Duffel Stays is enabled on your Duffel account.
DUFFEL_STAYS_ENABLED=false

# Mapbox token enables live traffic-aware ETAs (falls back to distance estimate if unset).
MAPBOX_TOKEN=
