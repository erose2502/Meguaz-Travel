# TLS + static front-end + API reverse proxy for the Meguaz app.
# MEGUAZ_DOMAIN comes from deploy/.env; with "localhost" Caddy serves plain
# HTTP locally, with a real domain it provisions Let's Encrypt automatically.
#
# Cloudflare users: with the DNS record set to "DNS only" (grey cloud) the
# default Let's Encrypt flow below just works. With the proxy ON (orange
# cloud), set Cloudflare SSL/TLS to "Full (strict)", create an Origin Server
# certificate in the Cloudflare dashboard, save it as deploy/certs/origin.pem
# and deploy/certs/origin.key, and uncomment the `tls` line below.

# Bare domain → www, so typing meguaz.com never dead-ends.
meguaz.com {
	redir https://www.meguaz.com{uri} permanent
}

{$MEGUAZ_DOMAIN:localhost} {
	encode gzip

	# Cloudflare Origin CA certificate (proxied/orange-cloud mode only):
	# tls /certs/origin.pem /certs/origin.key

	# Same-origin API keeps keys server-side and needs no CORS.
	handle /api/* {
		reverse_proxy web:3000
	}

	# OAuth landing (Google → Supabase → here) lives on the backend too.
	handle /auth/* {
		reverse_proxy web:3000
	}

	# Hashed bundle files: cache forever — and 404 when missing. The SPA
	# fallback must NEVER serve HTML for a dead bundle hash: a stale mobile
	# shell would receive index.html as "JavaScript", fail the module MIME
	# check, and sit on a blank page.
	handle /assets/* {
		root * /srv/app
		# Only files that exist earn the immutable header. A 404 carrying
		# max-age=1y gets pinned by Cloudflare's edge for a year — after
		# which no deploy can ever heal that URL for that colo.
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		header ?Cache-Control "no-store"
		# A request for a hashed .js we no longer have = a stale cached
		# shell. Serve the reloader stub (valid JS, correct MIME) so the
		# client pulls the current shell instead of dying on a blank page.
		@stalejs {
			path *.js
			not file
		}
		rewrite @stalejs /assets-reloader.js
		file_server
	}

	# Generated hero videos/backdrops keep stable names so a regenerated
	# clip can replace one in place — a week of caching, not immutable.
	# Behind Cloudflare's proxy these are also cached at the edge, so each
	# video leaves this box roughly once per week total.
	handle /media/* {
		root * /srv/app
		@exists file
		header @exists Cache-Control "public, max-age=604800"
		header ?Cache-Control "no-store"
		file_server
	}

	# Vite SPA shell (npm run build at the repo root → dist/). Must always
	# revalidate or deploys don't take effect.
	handle {
		root * /srv/app
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	# Caddy-generated errors (file_server 404s) bypass the route's header
	# ops, arriving at Cloudflare with no Cache-Control — which then applies
	# its default 4h edge TTL. Errors must say no-store themselves.
	handle_errors {
		header Cache-Control "no-store"
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}
